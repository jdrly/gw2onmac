---
// Support ("Need help?") and the footer with the disclaimer, on the surface colour.
import Icon from './Icon.astro';
import { disclaimer, links } from '../data/site';

const buttons = [
  { href: links.discord, label: 'Discord', icon: 'message-circle' as const },
  { href: links.issues, label: 'GitHub issues', icon: 'github' as const },
];
const footerLinks = [
  { href: links.repo, label: 'Source' },
  { href: links.dxmt, label: 'DXMT fork' },
  { href: links.license, label: 'Licence' },
];
---

<footer id="support" class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-[18px] px-5 pt-10 pb-8 md:gap-7 md:px-16 md:pt-14 md:pb-10">
    <div class="flex flex-col gap-[18px] md:flex-row md:items-center md:justify-between md:gap-10">
      <div class="flex max-w-[640px] flex-col gap-[18px] md:gap-1.5">
        <h2 class="font-head text-[26px] leading-[1.25] text-fg md:text-[30px]">Need help?</h2>
        <p class="text-[15.5px] leading-[1.4] text-fg-2 md:text-[17px]">
          Ask on Discord or open a GitHub issue, and attach Collect Logs. Please don't contact ArenaNet or Steam
          support about GW2 on Mac.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-2.5 md:flex md:shrink-0 md:gap-3">
        {
          buttons.map((b) => (
            <a
              href={b.href}
              class="flex h-11 items-center justify-center gap-2 rounded-lg border border-line-strong bg-raised px-[18px] text-[15px] font-bold text-fg transition-colors hover:bg-bg md:h-[41px] md:text-base"
            >
              <Icon name={b.icon} size={17} class="size-4 md:size-[17px]" />
              {b.label}
            </a>
          ))
        }
      </div>
    </div>

    <hr class="border-line" />

    <div class="flex flex-col gap-[18px] md:flex-row md:items-center md:justify-between md:gap-10">
      <p class="max-w-[820px] text-[13px] leading-[1.4] text-fg-3 md:text-sm">{disclaimer}</p>
      <ul class="flex shrink-0 flex-wrap items-center gap-x-[18px] gap-y-2 text-[13.5px] md:gap-x-[22px] md:text-sm">
        {
          footerLinks.map((l) => (
            <li>
              <a href={l.href} class="font-bold text-accent hover:underline">
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="text-fg-3 max-md:hidden">© 2026 Jan Drlý</li>
      </ul>
    </div>
  </div>
</footer>

---
// The header on the ink band: the wordmark, the section links, GitHub, Discord and the theme
// toggle. Below lg, a menu button opens a full-screen menu (a native <details>, so it works
// without JS; the script closes it on navigation, Escape and when the layout grows past it).
import Wordmark from './Wordmark.astro';
import DownloadButton from './DownloadButton.astro';
import Icon, { type Name } from './Icon.astro';
import { links } from '../data/site';
import type { Release } from '../lib/releases';

interface Props {
  release: Release | undefined;
}

const { release } = Astro.props;

const nav: { href: string; label: string; icon: Name }[] = [
  { href: '#features', label: 'Features', icon: 'sparkles' },
  { href: '#install', label: 'Install', icon: 'download' },
  { href: '#releases', label: 'Releases', icon: 'scroll-text' },
  { href: '#faq', label: 'FAQ', icon: 'info' },
];

const external = [
  { href: links.repo, label: 'GitHub', icon: 'github' as const },
  { href: links.discord, label: 'Discord', icon: 'message-circle' as const },
];

const glass = 'border border-[#f6e6c455] bg-[#1e181399] text-ink-fg transition-colors hover:bg-[#1e1813cc]';
const themes = [
  { choice: 'auto', label: 'System', icon: 'monitor' },
  { choice: 'light', label: 'Light', icon: 'sun' },
  { choice: 'dark', label: 'Dark', icon: 'moon' },
] as const;
---

<header class="relative z-10">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 lg:h-[84px] lg:px-16">
    <a href="#top" class="-m-1 rounded-lg p-1" aria-label="GW2 on Mac, back to top">
      <Wordmark />
    </a>

    <nav aria-label="Main" class="absolute left-1/2 hidden -translate-x-1/2 lg:block">
      <ul class="flex items-center gap-[34px]">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="ink-text py-2 font-head text-[17px] text-ink-fg underline-offset-6 hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2.5">
      {
        external.map((l) => (
          <a href={l.href} class:list={['hidden h-[29px] items-center gap-[7px] rounded-md px-3 text-sm leading-none font-medium lg:flex', glass]}>
            <Icon name={l.icon} size={15} />
            {l.label}
          </a>
        ))
      }
      <button
        type="button"
        data-theme-toggle
        data-choice="auto"
        aria-label="Switch colour theme"
        class:list={['group hidden size-[34px] place-items-center rounded-md lg:grid', glass]}
      >
        <Icon name="sun-moon" size={16} class="group-data-[choice=dark]:hidden group-data-[choice=light]:hidden" />
        <Icon name="sun" size={16} class="hidden group-data-[choice=light]:block" />
        <Icon name="moon" size={16} class="hidden group-data-[choice=dark]:block" />
      </button>

      <details id="site-menu" class="group/menu lg:hidden">
        <summary
          class:list={[
            'relative z-50 grid size-[38px] list-none place-items-center rounded-[7px] select-none group-open/menu:bg-[#00000033] [&::-webkit-details-marker]:hidden',
            glass,
          ]}
          aria-label="Menu"
        >
          <Icon name="menu" size={20} class="group-open/menu:hidden" />
          <Icon name="x" size={20} class="hidden group-open/menu:block" />
        </summary>

        <div class="fixed inset-0 z-40 flex flex-col overflow-y-auto overscroll-contain bg-bg" data-lenis-prevent>
          <div class="flex h-16 shrink-0 items-center border-b border-line px-5" style="background: var(--c-menu-bar)" aria-hidden="true">
            <Wordmark />
          </div>
          <div class="mx-auto flex w-full max-w-xl flex-1 flex-col px-5 pt-4 pb-7">
            <nav aria-label="Menu">
              <ul>
                {
                  nav.map((item) => (
                    <li class="border-b border-line">
                      <a href={item.href} class="flex items-center gap-3.5 px-1 py-[18px] font-head text-2xl leading-[1.25] text-fg hover:text-accent">
                        <Icon name={item.icon} size={20} class="text-accent" />
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>

            <div class="mt-auto flex flex-col gap-3 pt-10">
              <div class="flex items-center justify-between gap-4 pb-1">
                <span id="menu-appearance" class="text-[15px] font-bold text-fg-3">Appearance</span>
                <div class="flex gap-1 rounded-lg border border-line-strong bg-raised p-1" role="group" aria-labelledby="menu-appearance">
                  {
                    themes.map((t) => (
                      <button
                        type="button"
                        data-theme-choice={t.choice}
                        aria-pressed={t.choice === 'auto' ? 'true' : 'false'}
                        class="flex h-9 items-center gap-1.5 rounded-md px-2.5 text-[15px] font-medium text-fg-2 hover:text-fg aria-pressed:bg-accent-soft aria-pressed:text-accent"
                      >
                        <Icon name={t.icon} size={15} />
                        {t.label}
                      </button>
                    ))
                  }
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2.5">
                {
                  external.map((l) => (
                    <a
                      href={l.href}
                      class="flex h-[46px] items-center justify-center gap-2 rounded-lg border border-line-strong bg-raised text-[15.5px] font-bold text-fg hover:bg-surface"
                    >
                      <Icon name={l.icon} size={16} />
                      {l.label}
                    </a>
                  ))
                }
              </div>
              <DownloadButton release={release} class="w-full" />
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style is:global>
  html:has(#site-menu[open]) {
    overflow: hidden;
  }
</style>

<script>
  const menu = document.getElementById('site-menu') as HTMLDetailsElement | null;
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) menu.open = false;
    });
  }
</script>

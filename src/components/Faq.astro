---
// #faq: "Is it safe?" (three statements) and the FAQ as <details>, the first one open.
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import Responsive from './Responsive.astro';
import { faq, safety } from '../data/content';
---

<section id="faq" aria-labelledby="faq-title" class="border-t border-line">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-6 px-5 py-12 md:gap-9 md:px-16 md:py-[72px]">
    <SectionHeading id="faq-title" kicker="Safety" title="Is it safe?" />
    <ul class="grid gap-6 md:grid-cols-2 md:gap-x-10 md:gap-y-8 lg:grid-cols-3">
      {
        safety.map((s) => (
          <li class="grid grid-cols-[20px_minmax(0,1fr)] gap-x-3 gap-y-[3px] md:grid-cols-[22px_minmax(0,1fr)] md:gap-x-2.5 md:gap-y-2.5">
            <Icon name={s.icon} size={22} class:list={['row-span-2 size-5 md:row-span-1 md:size-[22px] md:self-center', s.tone === 'gold' ? 'text-gold' : 'text-accent']} />
            <h3 class="font-head text-lg leading-[1.25] text-fg md:text-[22px]">{s.title}</h3>
            <p class="text-[15.5px] leading-[1.4] text-fg-2 md:col-span-2 md:text-[17px]">
              <Responsive copy={s.text} />
            </p>
          </li>
        ))
      }
    </ul>

    <div class="overflow-hidden rounded-xl border border-line bg-raised">
      {
        faq.map((item, i) => (
          <details class="group/faq border-line not-last:border-b" open={i === 0}>
            <summary class="flex list-none items-center gap-2.5 px-4 py-[15px] select-none hover:bg-surface/40 md:px-6 md:py-[18px] [&::-webkit-details-marker]:hidden">
              <h3 class="flex-1 text-base leading-[1.15] font-bold text-fg md:text-lg">
                <Responsive copy={item.q} />
              </h3>
              <Icon name="chevron-down" size={18} class="size-[17px] text-fg-3 transition-transform duration-300 group-open/faq:rotate-180 md:size-[18px]" />
            </summary>
            <div class="answer flex flex-col gap-2 px-4 pb-4 text-[15.5px] leading-[1.4] text-fg-2 md:-mt-2.5 md:px-6 md:pb-[18px] md:text-[16.5px]">
              {item.a.map((p) => (
                <p set:html={p} />
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .answer :global(a) {
    color: var(--c-accent);
    font-weight: 700;
  }
  .answer :global(code) {
    padding: 0 4px;
    border-radius: 4px;
    background: var(--c-surface);
    color: var(--c-fg);
    font-size: 0.95em;
  }
</style>

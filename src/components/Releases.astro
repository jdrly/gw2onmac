---
// #releases: stable releases from GitHub, newest first. The newest is open; older ones fold into
// a <details> showing their one-line summary. Before the first release: a "coming soon" entry.
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { links } from '../data/site';
import { formatDate, type Release } from '../lib/releases';

interface Props {
  releases: Release[];
}

const { releases } = Astro.props;

// The release title is shown by the entry; the notes' "###" changes become h4 under the h3 version.
const notesHtml = (r: Release) => r.bodyHtml.replace(/<(\/?)h3\b/g, '<$1h4');
const tag = (i: number) => (releases.length === 1 ? 'First release' : i === 0 ? 'Latest' : undefined);
const row = 'flex flex-col gap-2.5 border-t border-line pt-4 pb-2 md:flex-row md:gap-8 md:py-[22px]';
const meta = 'flex shrink-0 flex-wrap items-center gap-x-2.5 gap-y-1.5 md:w-[220px] md:flex-col md:items-start md:gap-1.5';
const version = 'font-display text-2xl leading-[1.3] font-bold text-accent md:text-[30px]';
const dateClass = 'text-sm text-fg-3 md:text-[15px]';
const tagClass = 'rounded-[5px] bg-gold-soft px-2 py-[3px] text-xs leading-none font-bold text-gold md:text-[13px]';
---

<section id="releases" aria-labelledby="releases-title" class="border-t border-line">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-6 px-5 py-12 md:gap-9 md:px-16 md:py-[72px]">
    <SectionHeading id="releases-title" kicker="Releases" title="Release notes" />
    {
      releases.length === 0 ? (
        <div class={row}>
          <div class={meta}>
            <span class={version}>Soon</span>
            <span class={tagClass}>First release</span>
          </div>
          <p class="notes min-w-0 flex-1 md:pt-1.5">
            First release coming soon. It will show up here with its notes, and the Download button will
            work, as soon as it's out on GitHub.
          </p>
        </div>
      ) : (
        <ol aria-label="Releases, newest first">
          {releases.map((r, i) => {
            const t = tag(i);
            return (
              <li id={`v${r.version}`} class={row}>
                <div class={meta}>
                  <h3 class={version}>
                    <span class="sr-only">GW2 on Mac </span>
                    {r.version}
                  </h3>
                  <time datetime={r.publishedAt.toISOString()} class={dateClass}>
                    {formatDate(r.publishedAt)}
                  </time>
                  {t && <span class={tagClass}>{t}</span>}
                </div>
                <div class="min-w-0 flex-1 md:pt-1.5">
                  {i === 0 ? (
                    <div class="notes">
                      {r.summary && <p>{r.summary}</p>}
                      <Fragment set:html={notesHtml(r)} />
                    </div>
                  ) : (
                    <details class="group/rel">
                      <summary class="flex list-none items-start justify-between gap-4 select-none [&::-webkit-details-marker]:hidden">
                        <span class="notes">
                          <p>{r.summary || 'Release notes'}</p>
                        </span>
                        <Icon name="chevron-down" size={18} class="mt-1 text-fg-3 transition-transform duration-300 group-open/rel:rotate-180" />
                      </summary>
                      <div class="notes pt-4">
                        <Fragment set:html={notesHtml(r)} />
                      </div>
                    </details>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      )
    }
    <p class="text-[15px] text-fg-3">
      All releases, with their downloads, are on <a href={links.releases} class="font-bold text-accent hover:underline">GitHub</a>.
    </p>
  </div>
</section>

<style>
  .notes {
    color: var(--c-fg-2);
    font-size: 15.5px;
    line-height: 1.4;
    overflow-wrap: break-word;
  }
  @media (width >= 48rem) {
    .notes {
      font-size: 17px;
    }
  }
  .notes > :global(* + *) {
    margin-top: 0.75rem;
  }
  .notes :global(h2),
  .notes :global(h4) {
    margin-top: 1.5rem;
    color: var(--c-fg);
    font-family: var(--font-marcellus), serif;
    font-size: 1.15em;
    line-height: 1.3;
  }
  .notes :global(strong),
  .notes :global(em) {
    color: var(--c-fg);
  }
  .notes :global(strong) {
    font-weight: 700;
  }
  .notes :global(a) {
    color: var(--c-accent);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--c-accent) 45%, transparent);
  }
  .notes :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .notes :global(code) {
    padding: 0 5px;
    border-radius: 4px;
    background: var(--c-surface);
    color: var(--c-fg);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }
  .notes :global(pre) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    background: var(--c-surface);
    overflow-x: auto;
  }
  .notes :global(pre code) {
    padding: 0;
    background: none;
    overflow-wrap: normal;
  }
  .notes :global(ul),
  .notes :global(ol) {
    padding: 0;
    list-style: none;
  }
  .notes :global(li) {
    position: relative;
    padding-left: 15px;
  }
  .notes :global(li + li) {
    margin-top: 8px;
  }
  .notes :global(ul > li::before) {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--c-accent);
  }
  .notes :global(ol) {
    counter-reset: note;
  }
  .notes :global(ol > li) {
    counter-increment: note;
    padding-left: 22px;
  }
  .notes :global(ol > li::before) {
    content: counter(note) '.';
    position: absolute;
    left: 0;
    color: var(--c-accent);
    font-weight: 700;
  }
  .notes :global(blockquote) {
    padding-left: 1rem;
    border-left: 2px solid var(--c-border-strong);
  }
  .notes :global(img) {
    max-width: 100%;
    height: auto;
  }
  .notes :global(hr) {
    border: 0;
    border-top: 1px solid var(--c-border);
  }
</style>

---
// Lucide icons, as in the design. GitHub isn't in Lucide any more (no brand icons), so it's the
// last Lucide version of it, inline.
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Clock from '@lucide/astro/icons/clock';
import Download from '@lucide/astro/icons/download';
import FileText from '@lucide/astro/icons/file-text';
import Flame from '@lucide/astro/icons/flame';
import Gamepad2 from '@lucide/astro/icons/gamepad-2';
import Info from '@lucide/astro/icons/info';
import Lock from '@lucide/astro/icons/lock';
import Menu from '@lucide/astro/icons/menu';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Monitor from '@lucide/astro/icons/monitor';
import Moon from '@lucide/astro/icons/moon';
import ScrollText from '@lucide/astro/icons/scroll-text';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Sparkles from '@lucide/astro/icons/sparkles';
import Store from '@lucide/astro/icons/store';
import Sun from '@lucide/astro/icons/sun';
import SunMoon from '@lucide/astro/icons/sun-moon';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import Type from '@lucide/astro/icons/type';
import X from '@lucide/astro/icons/x';
import Zap from '@lucide/astro/icons/zap';

const icons = {
  'arrow-down': ArrowDown,
  'chevron-down': ChevronDown,
  clock: Clock,
  download: Download,
  'file-text': FileText,
  flame: Flame,
  'gamepad-2': Gamepad2,
  info: Info,
  lock: Lock,
  menu: Menu,
  'message-circle': MessageCircle,
  monitor: Monitor,
  moon: Moon,
  'scroll-text': ScrollText,
  'shield-check': ShieldCheck,
  sparkles: Sparkles,
  store: Store,
  sun: Sun,
  'sun-moon': SunMoon,
  'triangle-alert': TriangleAlert,
  type: Type,
  x: X,
  zap: Zap,
};

export type Name = keyof typeof icons | 'github';

interface Props {
  name: Name;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const Lucide = name === 'github' ? undefined : icons[name];
---

{
  Lucide ? (
    <Lucide size={size} class:list={['shrink-0', className]} aria-hidden="true" />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={['shrink-0', className]}
      aria-hidden="true"
    >
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
      <path d="M9 18c-4.51 2-5-2-7-2" />
    </svg>
  )
}

---
// A section's kicker (a red tick and a word) and its title.
interface Props {
  id: string;
  kicker: string;
  title: string;
}

const { id, kicker, title } = Astro.props;
---

<div class="flex flex-col gap-2 md:gap-2.5">
  <p class="flex items-center gap-2 text-sm leading-none font-bold text-accent md:gap-2.5 md:text-[15px] md:tracking-[0.6px]">
    <span class="h-[3px] w-[18px] rounded-full bg-accent md:w-[22px]" aria-hidden="true"></span>
    {kicker}
  </p>
  <h2 id={id} class="font-head text-[32px] leading-[1.25] text-fg md:text-[44px]">{title}</h2>
</div>

---
// The "GW2 on Mac" wordmark on the red ink band: the app icon, GW2 and ON MAC in Cinzel.
// Smaller below lg, as in the mobile frames.
import { Image } from 'astro:assets';
import icon from '../assets/art/app-icon.png';
---

<span class="flex items-center gap-[9px] lg:gap-3">
  <Image
    src={icon}
    alt=""
    width={80}
    height={80}
    class="size-8 rounded-[7px] shadow-[0_2px_6px_#00000055] lg:size-10 lg:rounded-[9px]"
    loading="eager"
  />
  <span class="font-display text-[22px] leading-none font-bold tracking-[1.5px] text-ink-fg [text-shadow:0_1px_6px_#3a0805b3] lg:text-[28px]">
    GW2
  </span>
  <span class="ml-0.5 font-display text-[11px] leading-none font-bold tracking-[3px] text-ink-fg-2 [text-shadow:0_1px_5px_#3a0805e6] lg:text-sm lg:tracking-[4px]">
    ON MAC
  </span>
</span>

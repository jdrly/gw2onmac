---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import Responsive from './Responsive.astro';
import { features } from '../data/content';
---

<section id="features" aria-labelledby="features-title" class="border-t border-line">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-6 px-5 py-12 md:gap-9 md:px-16 md:py-[72px]">
    <SectionHeading id="features-title" kicker="Features" title="What it does" />
    <ul class="grid gap-6 md:grid-cols-2 md:gap-x-10 md:gap-y-9 lg:grid-cols-3">
      {
        features.map((f) => (
          <li class="grid grid-cols-[34px_minmax(0,1fr)] gap-x-3 gap-y-1 border-t border-line pt-4 md:grid-cols-[38px_minmax(0,1fr)] md:gap-y-2.5 md:pt-[22px]">
            <span class="row-span-2 grid size-[34px] place-items-center rounded-full bg-accent-soft text-accent md:row-span-1 md:size-[38px]">
              <Icon name={f.icon} size={18} />
            </span>
            <h3 class="font-head text-[19px] leading-[1.25] text-fg md:self-center md:text-[22px]">{f.title}</h3>
            <p class="text-[15.5px] leading-[1.4] text-fg-2 md:col-span-2 md:text-[17px]">
              <Responsive copy={f.text} />
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
